// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  GUEST
}

enum OtpType {
  EMAIL_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELIVERED
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String?
  name       String?
  role       Role     @default(USER)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  otps       Otp[]
  orders     InvitationOrder[]

  @@map("users")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      OtpType  @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@map("otps")
}

model Template {
  id           String            @id @default(uuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?
  category     String            @default("Traditional")
  price        Float             @default(0)
  duration     String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  orders       InvitationOrder[]

  @@map("templates")
}

model InvitationOrder {
  id               String       @id @default(uuid())
  orderNumber      String       @unique
  status           OrderStatus  @default(PENDING)

  templateId       String?
  template         Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)

  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Client Details
  clientName       String
  clientEmail      String
  clientPhone      String

  // Couple Details
  brideName        String
  groomName        String
  brideParents     String?
  groomParents     String?

  // Page-by-page Functions (Haldi, Mehendi, Sangeet, Wedding, Reception, etc.)
  events           Json

  // Custom Preferences
  musicPreference  String?
  customTextNotes  String?
  photoUrls        Json?

  // Admin Fulfillment Details
  finalVideoUrl    String?
  adminNotes       String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([clientEmail])
  @@index([status])
  @@map("invitation_orders")
}
